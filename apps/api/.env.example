# Copy to .env.dev (gitignored) and adjust. Loaded by `npm run start:dev` via --env-file.
ADDRESS=localhost
PORT=5174
LOG_LEVEL=info
ENV=local
APP_URL=http://localhost:5173
# Magic links point here (defaults to APP_URL)
PORTAL_URL=http://localhost:5173

# Auth — the api is its own token issuer (EdDSA). Generate a key with `node scripts/gen-auth-key.mjs`;
# leave AUTH_JWT_PRIVATE_KEY empty to use an ephemeral key (tokens die on restart, fine locally).
# In AWS the ARN below is set by CDK and resolved from Secrets Manager at startup.
AUTH_AUDIENCE=mjukvaruhuset
#AUTH_ISSUER=http://localhost:5174
#AUTH_JWT_PRIVATE_KEY={"kty":"OKP","crv":"Ed25519","x":"...","d":"..."}
#AUTH_JWT_PRIVATE_KEY_SECRET_ARN=
# Comma-separated emails that sign in as admin
AUTH_ADMIN_EMAILS=hasse.lofgren@outlook.com
# Email: `log` prints the magic link in the api log (default outside live); `ses` sends via SES v2
EMAIL_TRANSPORT=log
AUTH_EMAIL_FROM=noreply@mjukvaruhuset.se

# Spec engine (M2): key from env locally; in AWS the secret ARN below is resolved at startup
#ANTHROPIC_API_KEY=
#ANTHROPIC_API_KEY_SECRET_ARN=
#SPEC_MODEL=claude-sonnet-5
# Postgres for build jobs (M3): `docker compose up -d` + `npm run db:migrate`. In AWS the secret ARN is set by CDK.
DATABASE_URL=postgres://mf:mf@localhost:5432/mf
#DATABASE_SECRET_ARN=
#ARTIFACTS_BUCKET=
#JOBS_CLUSTER_ARN=
#JOB_TASK_DEFINITION_ARN=
#JOB_SUBNET_IDS=subnet-a,subnet-b
#JOB_SECURITY_GROUP_ID=
#STRIPE_SECRET_KEY_SECRET_ARN=
#STRIPE_WEBHOOK_SECRET_SECRET_ARN=

# Stripe (M6): test-mode keys locally; without STRIPE_SECRET_KEY the FAKE provider marks payments paid at once
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
