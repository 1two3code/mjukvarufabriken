{
  "name": "@mf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "start:dev": "node --watch --env-file=.env.dev src/index.ts",
    "lint": "eslint ./; tsgo --noemit",
    "test": "vitest run --reporter=verbose",
    "tsgo:watch": "tsgo --noemit --watch"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.32.0",
    "msw": "^2.14.6"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1118.0",
    "@aws-sdk/client-ecr": "^3.1118.0",
    "@aws-sdk/client-ecs": "^3.1119.0",
    "@aws-sdk/client-organizations": "^3.1118.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1119.0",
    "@aws-sdk/client-sesv2": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@mf/access-control": "*",
    "@mf/db": "*",
    "@mf/harness": "*",
    "@mf/models": "*",
    "@mf/org": "*",
    "@mf/utils": "*",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.3",
    "stripe": "^22.6.0",
    "zod": "^4.4.3"
  }
}
