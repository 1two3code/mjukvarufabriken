{
  "name": "@mf/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "vite --mode dev",
    "build": "vite build --mode dev --outDir 'dist/dev' && vite build --mode qa --outDir 'dist/qa' && vite build --mode live --outDir 'dist/live'",
    "preview": "vite preview",
    "lint": "eslint ./src ./test; stylelint \"./src/**/*.css\"; tsgo --noemit",
    "test": "vitest run",
    "tsgo:watch": "tsgo --noemit --watch"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@mf/access-control": "*",
    "@mf/models": "*",
    "@mf/utils": "*",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react": "^10.72.0",
    "async-mutex": "^0.5.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lightningcss": "^1.32.0",
    "stylelint": "^17.12.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0"
  }
}
