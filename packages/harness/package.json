{
  "name": "@mf/harness",
  "version": "0.1.0",
  "description": "Model harness: spec engine (M2) and build-job orchestrator (M3)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint; tsgo --noemit",
    "test": "vitest run --reporter=verbose",
    "spec:demo": "node scripts/spec-demo.ts",
    "gates:demo": "node scripts/gates-demo.ts",
    "delivery:demo": "node scripts/delivery-demo.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./spec": "./src/spec/index.ts",
    "./job": "./src/job/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-apprunner": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@mf/models": "*",
    "@octokit/rest": "^22.0.1",
    "zod": "^4.4.3"
  },
  "imports": {
    "#spec/*": "./src/spec/*",
    "#job/*": "./src/job/*"
  }
}
