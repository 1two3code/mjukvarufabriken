{
  "name": "@mf/resident",
  "version": "0.1.0",
  "description": "Resident agent (M8): long-running service in the customer's AWS account that turns issues into pull requests through the @mf/harness orchestrator, under a monthly token cap with a pause switch, an audit log and daily metering",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "lint": "eslint ./; tsgo --noemit",
    "test": "vitest run --reporter=verbose"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "@mf/harness": "*",
    "@mf/models": "*",
    "@octokit/rest": "^22.0.1",
    "fastify": "^5.11.3",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  }
}
