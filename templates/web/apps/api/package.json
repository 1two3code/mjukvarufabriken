{
  "name": "@template/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "start:dev": "node --watch --env-file=.env.dev src/index.ts",
    "lint": "eslint ./; tsgo --noemit",
    "test": "vitest run --reporter=verbose",
    "tsgo:watch": "tsgo --noemit --watch"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.32.0",
    "msw": "^2.14.6"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@template/access-control": "*",
    "@template/models": "*",
    "@template/utils": "*",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  }
}
