{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "tsgo:watch",
      "path": "/apps/api",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsgo-watch-api",
        "fileLocation": ["relative", "${workspaceFolder}/apps/api"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+)\\s+-\\s+(error|warning)\\s+TS(\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build starting at.*$",
          "endsPattern": "^build finished in.*$"
        }
      },
      "label": "tsgo:watch api",
      "detail": "Watch TypeScript errors in api",
      "presentation": {
        "reveal": "never",
        "revealProblems": "onProblem",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true,
      }
    },
    {
      "type": "npm",
      "script": "tsgo:watch",
      "path": "/apps/app",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsgo-watch-app",
        "fileLocation": ["relative", "${workspaceFolder}/apps/app"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+)\\s+-\\s+(error|warning)\\s+TS(\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build starting at.*$",
          "endsPattern": "^build finished in.*$"
        }
      },
      "label": "tsgo:watch app",
      "detail": "Watch TypeScript errors in app",
      "presentation": {
        "reveal": "never",
        "revealProblems": "onProblem",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true,
      }
    },
    {
      "label": "tsgo:watch all",
      "dependsOn": ["tsgo:watch app", "tsgo:watch api"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}