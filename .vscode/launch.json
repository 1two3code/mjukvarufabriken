{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "@template/api", "run", "start:dev"],
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug App",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "@template/app", "run", "start:dev"],
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Chrome debug",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/app"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full-Stack",
      "configurations": ["Debug API", "Debug App", "Chrome debug"]
    }
  ]
}
