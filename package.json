{
  "name": "mjukvaruhuset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "npm run start:dev -w @mf/site & npm run start:dev -w @mf/portal & npm run start:dev -w @mf/api & wait",
    "build": "npm run build --workspaces --if-present",
    "smoke": "node scripts/smoke-spa.mjs site portal",
    "version:patch": "npm version patch --workspaces --include-workspace-root --no-git-tag-version",
    "version:minor": "npm version minor --workspaces --include-workspace-root --no-git-tag-version",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "e2e": "vitest run packages/harness/test/job/e2e.offline.test.ts",
    "e2e:replay": "node --env-file-if-exists=.env packages/harness/scripts/replay-run.ts",
    "coverage": "vitest run --coverage --reporter=dot",
    "clean": "find . -maxdepth 3 -name 'package-lock.json' -exec rm -r {} \\;; find . -maxdepth 3 -name 'node_modules' -prune -exec rm -rf {} \\;; npm run clean:output",
    "clean:output": "rm -rf apps/site/dist apps/portal/dist; find . -maxdepth 3 -name 'coverage' -prune -exec rm -rf {} \\;; find . -maxdepth 3 -name 'cdk.out' -prune -exec rm -rf {} \\;",
    "upgrade": "npx npm-check-updates --workspaces --target semver -u; npm i",
    "prepare": "husky",
    "spec:demo": "node --env-file-if-exists=.env packages/harness/scripts/spec-demo.ts",
    "gates:demo": "node --env-file-if-exists=.env packages/harness/scripts/gates-demo.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/db/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env packages/db/scripts/seed-demo.ts",
    "job:dev": "node --env-file-if-exists=.env apps/job/src/index.ts",
    "delivery:demo": "node --env-file-if-exists=.env packages/harness/scripts/delivery-demo.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24.14"
  }
}
